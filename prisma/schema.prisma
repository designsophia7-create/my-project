generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CategoryType {
  NEW_RELEASE
  PREORDER
  SUBSCRIPTION
  GIFT_CARD
  CATALOG
}

enum Platform {
  XBOX_SERIES
  XBOX_ONE
  PC
  PSN
  NINTENDO
  MULTI
}

enum ProductType {
  GAME
  PREORDER
  GIFT_CARD
  SUBSCRIPTION
}

enum RegionLock {
  GLOBAL
  US
  EU
  UK
  ROW
}

enum KeyStatus {
  AVAILABLE
  RESERVED
  SOLD
  REVOKED
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  REFUNDED
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  CRYPTO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String?  @map("password_hash")
  name              String?
  role              Role     @default(CUSTOMER)
  preferredCurrency String?  @map("preferred_currency") @db.Char(3)
  preferredLocale   String?  @map("preferred_locale")
  detectedCountry   String?  @map("detected_country") @db.Char(2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  type      CategoryType @default(CATALOG)
  sortOrder Int          @default(0) @map("sort_order")

  products Product[]

  @@map("categories")
}

model Product {
  id                String      @id @default(uuid()) @db.Uuid
  categoryId        String      @map("category_id") @db.Uuid
  slug              String      @unique
  title             String
  description       String      @default("")
  platform          Platform
  productType       ProductType @map("product_type")
  regionLock        RegionLock  @default(GLOBAL) @map("region_lock")
  basePriceUsd      Decimal     @map("base_price_usd") @db.Decimal(10, 2)
  compareAtPriceUsd Decimal?    @map("compare_at_price_usd") @db.Decimal(10, 2)
  releaseDate       DateTime?   @map("release_date")
  isActive          Boolean     @default(true) @map("is_active")
  coverImageUrl     String?     @map("cover_image_url")
  metadata          Json        @default("{}")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  category   Category     @relation(fields: [categoryId], references: [id])
  keys       DigitalKey[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([productType, isActive])
  @@map("products")
}

model DigitalKey {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  encryptedKey String    @map("encrypted_key")
  status       KeyStatus @default(AVAILABLE)
  orderItemId  String?   @map("order_item_id") @db.Uuid
  batchId      String?   @map("batch_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  soldAt       DateTime? @map("sold_at")

  product   Product    @relation(fields: [productId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([productId, status])
  @@map("digital_keys")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  email     String
  status    OrderStatus @default(PENDING)
  currency  String      @db.Char(3)
  fxRate    Decimal     @default(1) @map("fx_rate") @db.Decimal(12, 6)
  subtotal  Decimal     @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  ipCountry String?     @map("ip_country") @db.Char(2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantity     Int     @default(1)
  unitPriceUsd Decimal @map("unit_price_usd") @db.Decimal(10, 2)

  order   Order        @relation(fields: [orderId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  keys    DigitalKey[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  gateway      PaymentGateway
  gatewayTxnId String         @unique @map("gateway_txn_id")
  status       PaymentStatus  @default(PENDING)
  amount       Decimal        @db.Decimal(10, 2)
  currency     String         @db.Char(3)
  rawWebhook   Json?          @map("raw_webhook")
  createdAt    DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model FxRate {
  currency  String   @id @db.Char(3)
  rateToUsd Decimal  @map("rate_to_usd") @db.Decimal(12, 6)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("fx_rates")
}
